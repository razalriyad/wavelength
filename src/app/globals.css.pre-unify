@import "tailwindcss";
:root {
  --ph: #9bff79;
  --line: #9bff7950;
  --dim: #9bff7790;
  --bg: #020702;
  --glow: 0 0 8px #8cff68, 0 0 24px #4cff3855;
}
* {
  box-sizing: border-box;
}
html,
body {
  margin: 0;
  min-height: 100%;
  background: #010401;
  color: var(--ph);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}
body {
  overflow-x: hidden;
}
button,
input,
select {
  font: inherit;
}
button {
  color: var(--ph);
  background: #041004;
  border: 1px solid var(--line);
  padding: 10px 13px;
  cursor: pointer;
  letter-spacing: 0.09em;
  transition:
    background 0.18s,
    color 0.18s,
    box-shadow 0.18s;
}
button:disabled {
  opacity: 0.5;
  cursor: wait;
}
button:hover,
button.active {
  background: var(--ph);
  color: #041004;
  box-shadow: var(--glow);
}
input,
select {
  accent-color: var(--ph);
  min-width: 0;
}
.crt {
  min-height: 100dvh;
  background:
    radial-gradient(ellipse at 50% 35%, #142b1040, transparent 62%), #010401;
  position: relative;
  overflow: hidden;
  --crt-intensity: 0.7;
  --crt-grain: 0.4;
  --crt-curve: 0.3;
  --crt-flicker: 0.2;
}
.crt[data-tone="blue"] {
  --ph: #78c0ff;
  --line: #438cff88;
  --dim: #72aaff99;
  --glow: 0 0 8px #168cff, 0 0 24px #064dff55;
}
.crt[data-crt="on"]:before {
  content: "";
  position: fixed;
  inset: -2%;
  z-index: 20;
  pointer-events: none;
  opacity: calc(var(--crt-intensity) * 0.8);
  background:
    repeating-linear-gradient(to bottom, transparent 0 2px, #0007 3px 4px),
    radial-gradient(ellipse at center, transparent 52%, #000 100%);
  animation:
    crtroll 7s linear infinite,
    crtflicker 4s steps(2, end) infinite;
  transform: perspective(1000px) scale(calc(1 + var(--crt-curve) * 0.025));
  border-radius: calc(var(--crt-curve) * 0.6%);
}
.crt[data-crt="on"]:after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 21;
  pointer-events: none;
  opacity: var(--crt-grain);
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.24'/%3E%3C/svg%3E");
  mix-blend-mode: screen;
  animation: grainmove 0.18s steps(3) infinite;
}
.crt[data-crt="on"] .app,
.crt[data-crt="on"] .topline,
.crt[data-crt="on"] .playerbar {
  text-shadow: 0 0 2px var(--ph);
}
@keyframes crtroll {
  0% {
    background-position:
      0 0,
      0 0;
  }
  to {
    background-position:
      0 100px,
      0 0;
  }
}
@keyframes grainmove {
  0% {
    transform: translate(0);
  }
  25% {
    transform: translate(1%, -1%);
  }
  50% {
    transform: translate(-1%, 1%);
  }
  75% {
    transform: translate(1%, 1%);
  }
  to {
    transform: translate(-1%);
  }
}
@keyframes crtflicker {
  0%,
  to {
    opacity: calc(var(--crt-intensity) * 0.78);
  }
  50% {
    opacity: calc(var(--crt-intensity) * 0.92);
  }
}
.topline {
  height: 42px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 20px;
  color: var(--dim);
  font-size: 9px;
  letter-spacing: 0.16em;
}
.topline i {
  height: 1px;
  background: var(--ph);
  flex: 1;
  box-shadow: var(--glow);
}
.topline button {
  font-size: 9px;
  padding: 6px 9px;
}
.app {
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  min-height: calc(100dvh - 112px);
  max-width: 1600px;
  margin: auto;
}
.nav {
  border-right: 1px solid var(--line);
  padding: 22px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}
.logo {
  font:
    700 48px ui-monospace,
    monospace;
  text-shadow: var(--glow);
  margin: 0 0 18px;
}
.logo span {
  font-size: 20px;
}
.nav small,
.heading small,
.micro,
.panelhead span,
.caption {
  font-size: 9px;
  letter-spacing: 0.16em;
  color: var(--dim);
}
.navlinks {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.nav button {
  text-align: left;
  border-color: transparent;
  border-bottom-color: #70ff5022;
  font-size: 10px;
  padding: 11px 8px;
}
.nav button i {
  font-style: normal;
  font-size: 9px;
  margin-right: 9px;
  color: var(--dim);
}
.navfoot {
  margin-top: auto;
  font-size: 10px;
}
.main {
  padding: 24px clamp(12px, 3vw, 42px);
  min-width: 0;
}
.heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 22px;
  gap: 12px;
  min-width: 0;
}
.heading h1 {
  font:
    700 clamp(23px, 4vw, 38px) ui-monospace,
    monospace;
  margin: 8px 0 0;
  letter-spacing: 0.05em;
}
.heading .micro {
  max-width: 52%;
  overflow-wrap: anywhere;
  text-align: right;
}
.panel {
  border: 1px solid var(--line);
  background: #03100388;
  padding: clamp(12px, 2vw, 24px);
  min-width: 0;
}
.panelhead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
  flex-wrap: wrap;
}
.panelhead h2,
.panel h2 {
  font:
    700 16px ui-monospace,
    monospace;
  letter-spacing: 0.06em;
  margin: 4px 0;
}
.homegrid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20px;
  align-items: center;
  min-height: 400px;
}
.homegrid h2 {
  font-size: clamp(26px, 5vw, 48px);
  line-height: 1.2;
}
.homeart {
  height: 270px;
  border: 1px solid var(--line);
  position: relative;
  min-width: 0;
}
.homeart canvas {
  width: 100%;
  height: 100%;
  display: block;
}
.homeart span {
  position: absolute;
  bottom: 10px;
  left: 12px;
  font-size: 9px;
  color: var(--dim);
}
.homeactions {
  grid-column: 1/-1;
  display: flex;
  gap: 9px;
  flex-wrap: wrap;
}
.notice {
  border-left: 2px solid var(--line);
  padding: 10px 12px;
  color: var(--dim);
  font-size: 10px;
  line-height: 1.7;
}
.warning {
  border-left-color: #ffb45e;
  color: #ffca8e;
}
.playergrid {
  display: grid;
  grid-template-columns: minmax(140px, 230px) minmax(0, 1fr);
  gap: 22px;
  align-items: center;
  margin-bottom: 22px;
}
.artwork {
  aspect-ratio: 1;
  background: radial-gradient(circle at 50% 40%, #24541d, #020602 68%);
  border: 1px solid var(--line);
  position: relative;
  overflow: hidden;
}
.artwork canvas {
  width: 100%;
  height: 100%;
}
.artwork b {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  font: 700 84px ui-monospace;
  text-shadow: var(--glow);
  pointer-events: none;
}
.playerinfo h2 {
  font-size: clamp(18px, 3vw, 28px);
  overflow-wrap: anywhere;
}
.seek {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 9px;
  margin: 18px 0;
}
.seek input {
  flex: 1;
  width: 100%;
}
.transport {
  display: flex;
  gap: 7px;
  flex-wrap: wrap;
  margin: 15px 0;
}
.transport button {
  min-width: 42px;
  padding: 10px;
}
.transport .play {
  font-size: 18px;
  min-width: 48px;
}
.signalmeta {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  color: var(--dim);
  font-size: 9px;
  letter-spacing: 0.12em;
}
.sourcebox {
  border-top: 1px solid var(--line);
  padding: 17px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.sourcehead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 9px;
  flex-wrap: wrap;
}
.sourcehead > b,
.sourcebox > b {
  font-size: 10px;
  letter-spacing: 0.14em;
}
.sourcehead select,
.fullinput,
.searchbar input {
  background: #010501;
  color: var(--ph);
  border: 1px solid var(--line);
  padding: 11px;
}
.searchbar {
  display: flex;
  gap: 8px;
  min-width: 0;
}
.searchbar input {
  flex: 1;
  width: 100%;
}
.searchbar button {
  white-space: nowrap;
}
.results {
  display: flex;
  flex-direction: column;
  gap: 3px;
  max-height: 310px;
  overflow: auto;
}
.resultrow {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  text-align: left;
  border: 0;
  border-bottom: 1px solid #70ff5022;
  background: #061006;
  padding: 9px;
  min-width: 0;
}
.resultrow:hover {
  background: #10230d;
}
.cover {
  width: 42px;
  height: 42px;
  flex: none;
  border: 1px solid var(--line);
  display: grid;
  place-items: center;
  overflow: hidden;
}
.cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.resulttext {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}
.resulttext b,
.resulttext small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.resulttext b {
  font-size: 10px;
}
.resulttext small {
  font-size: 9px;
  color: var(--dim);
}
.resultquality {
  font-size: 8px;
  color: var(--dim);
  white-space: nowrap;
}
.embedframe {
  height: 370px;
  border: 1px solid var(--line);
  background: #000;
  overflow: hidden;
}
.embedframe iframe {
  width: 100%;
  height: 100%;
  border: 0;
}
.fullinput {
  width: 100%;
}
.scope {
  height: clamp(220px, 40vw, 430px);
  border: 1px solid var(--line);
  position: relative;
  background: radial-gradient(ellipse, #0b220a, #010501 70%);
  overflow: hidden;
}
.scope canvas {
  width: 100%;
  height: 100%;
  display: block;
}
.corner {
  position: absolute;
  top: 12px;
  left: 14px;
  font-size: 9px;
  line-height: 1.7;
  color: var(--dim);
}
.corner.bottom {
  top: auto;
  bottom: 12px;
}
.livecontrols {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 16px 0;
}
.livecontrols label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 9px;
  color: var(--dim);
}
.livecontrols select {
  background: #010501;
  color: var(--ph);
  border: 1px solid var(--line);
  padding: 9px;
}
.inputmode {
  display: flex;
  gap: 5px;
}
.inputmode button {
  font-size: 9px;
}
.visualtiles {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(125px, 1fr));
  gap: 9px;
  margin-top: 14px;
}
.visualtiles button {
  text-align: left;
  padding: 8px;
  min-width: 0;
}
.visualtiles strong,
.visualtiles small {
  display: block;
  font-size: 9px;
  margin-top: 7px;
}
.visualtiles small {
  color: var(--dim);
  font-size: 8px;
}
.thumb {
  height: 68px;
  display: block;
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  background: radial-gradient(ellipse, #163316, #010401);
}
.thumb i,
.thumb b,
.thumb em {
  position: absolute;
  display: block;
  border: 1px solid var(--ph);
  box-shadow: var(--glow);
  left: 50%;
  top: 50%;
  width: 36px;
  height: 36px;
  transform: translate(-50%, -50%);
}
.thumb i {
  border-radius: 50%;
  animation: thumbpulse 3s ease-in-out infinite;
}
.thumb b {
  width: 70%;
  height: 1px;
  border: 0;
  background: var(--ph);
  animation: thumbsweep 3s linear infinite;
}
.thumb em {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  animation: thumborbit 4s linear infinite;
}
.thumb0 b {
  display: none;
}
.thumb1 i {
  width: 88%;
  height: 30%;
  border-radius: 0;
  transform: translate(-50%, -50%) skewY(-12deg);
}
.thumb2 b {
  height: 70%;
  width: 1px;
  transform: translate(-50%, -50%);
}
.thumb3 i {
  width: 80%;
  height: 1px;
  border: 0;
  border-top: 1px solid var(--ph);
  border-radius: 0;
}
.thumb4 em {
  width: 4px;
  height: 4px;
  box-shadow: 0 0 12px 4px var(--ph);
}
.thumb5 i {
  width: 40px;
  height: 40px;
  transform: translate(-50%, -50%) rotate(45deg);
  border-radius: 0;
}
.thumb6 i {
  width: 70%;
  height: 25%;
  border-radius: 50%;
}
.thumb7 i {
  width: 25px;
  height: 55px;
  border-radius: 50%;
}
.thumb8 b {
  width: 55%;
  height: 55%;
  border: 1px solid var(--ph);
  background: transparent;
  transform: translate(-50%, -50%) rotate(45deg);
}
.thumb9 i {
  width: 75%;
  height: 1px;
  border: 0;
  border-top: 2px dashed var(--ph);
  border-radius: 0;
}
@keyframes thumbpulse {
  0%,
  to {
    opacity: 0.35;
    scale: 0.8;
  }
  50% {
    opacity: 1;
    scale: 1.1;
  }
}
@keyframes thumbsweep {
  0% {
    transform: translate(-50%, -50%) rotate(0);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}
@keyframes thumborbit {
  0% {
    transform: translate(-50%, -50%) rotate(0) translate(22px);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg) translate(22px);
  }
}
.librarytabs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin: 14px 0;
}
.empty {
  text-align: center;
  padding: 30px 8px;
  color: var(--dim);
  font-size: 10px;
}
.moduleinfo {
  display: grid;
  grid-template-columns: minmax(110px, 180px) 1fr;
  gap: 12px;
  padding: 20px 0;
  font-size: 10px;
}
.moduleinfo span {
  color: var(--dim);
  overflow-wrap: anywhere;
}
.addonlink {
  display: inline-block;
  padding: 12px;
  border: 1px solid var(--line);
  color: var(--ph);
  font-size: 10px;
}
.diagrow {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  border-bottom: 1px solid #70ff5022;
  padding: 13px 4px;
  font-size: 10px;
}
.diagrow b {
  color: var(--dim);
  text-align: right;
}
.crtpanel {
  position: relative;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  padding: 14px 22px;
  background: #061006;
  border-bottom: 1px solid var(--line);
  font-size: 10px;
}
.crtpanel label {
  display: flex;
  align-items: center;
  gap: 7px;
}
.crtpanel input {
  width: 90px;
}
.playerbar {
  border-top: 1px solid var(--line);
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: #010801;
  position: sticky;
  bottom: 0;
  z-index: 10;
}
.playerbar > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.playerbar b {
  font-size: 10px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.playerbar small {
  font-size: 8px;
  color: var(--dim);
}
.barbuttons {
  display: flex;
  align-items: center;
  gap: 7px;
  max-width: 700px;
}
.barbuttons button {
  padding: 8px;
}
.barbuttons span {
  font-size: 9px;
  white-space: nowrap;
  color: var(--dim);
}
.crtpanel b {
  letter-spacing: 0.14em;
}
@media (max-width: 760px) {
  .topline {
    height: auto;
    min-height: 42px;
    padding: 7px 9px;
    gap: 6px;
    font-size: 7px;
    letter-spacing: 0.1em;
  }
  .topline button {
    font-size: 7px;
    padding: 6px 5px;
  }
  .app {
    grid-template-columns: minmax(0, 1fr);
    min-height: calc(100dvh - 105px);
  }
  .nav {
    border-right: 0;
    border-bottom: 1px solid var(--line);
    padding: 8px 9px;
    display: block;
  }
  .logo,
  .nav > small,
  .navfoot {
    display: none;
  }
  .navlinks {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
  }
  .nav button {
    padding: 9px 3px;
    font-size: 7px;
    text-align: center;
    white-space: normal;
    line-height: 1.25;
    min-height: 42px;
    overflow-wrap: anywhere;
  }
  .nav button i {
    display: block;
    margin: 0 0 3px;
    font-size: 7px;
  }
  .main {
    padding: 18px 11px;
  }
  .heading {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 14px;
  }
  .heading .micro {
    max-width: 100%;
    text-align: left;
    overflow-wrap: anywhere;
  }
  .panel {
    padding: 12px;
  }
  .homegrid {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    min-height: 0;
  }
  .homegrid h2 {
    font-size: clamp(25px, 8vw, 38px);
  }
  .homeart {
    height: 190px;
    min-width: 0;
  }
  .homeactions {
    grid-column: 1;
    gap: 6px;
  }
  .homeactions button {
    font-size: 8px;
    padding: 9px;
  }
  .playergrid {
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 11px;
    align-items: start;
  }
  .artwork b {
    font-size: 42px;
  }
  .playerinfo h2 {
    font-size: 17px;
  }
  .seek {
    gap: 5px;
    margin: 13px 0;
    font-size: 8px;
  }
  .transport {
    gap: 5px;
    margin: 12px 0;
  }
  .transport button {
    min-width: 0;
    padding: 9px 8px;
    font-size: 9px;
  }
  .transport .play {
    min-width: 40px;
  }
  .panelhead h2 {
    font-size: 13px;
  }
  .panelhead span {
    font-size: 8px;
  }
  .searchbar {
    flex-wrap: wrap;
  }
  .searchbar input {
    width: 100%;
    flex-basis: 100%;
  }
  .searchbar button {
    width: 100%;
  }
  .resultquality {
    display: none;
  }
  .embedframe {
    height: 320px;
  }
  .scope {
    height: 250px;
  }
  .livecontrols {
    gap: 8px;
  }
  .inputmode {
    width: 100%;
  }
  .inputmode button {
    flex: 1;
    padding: 9px 5px;
    font-size: 8px;
  }
  .visualtiles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
  }
  .visualtiles button {
    padding: 6px;
  }
  .thumb {
    height: 64px;
  }
  .moduleinfo {
    grid-template-columns: 100px minmax(0, 1fr);
    font-size: 9px;
  }
  .playerbar {
    padding: 9px 10px;
    gap: 7px;
  }
  .playerbar > small {
    display: none;
  }
  .barbuttons {
    gap: 4px;
  }
  .barbuttons button {
    padding: 8px 9px;
  }
  .barbuttons span {
    display: none;
  }
  .playerbar b {
    max-width: 115px;
    font-size: 9px;
  }
  .playerbar small {
    font-size: 7px;
  }
  .crtpanel {
    gap: 8px;
    padding: 10px;
  }
  .crtpanel label {
    width: 100%;
    justify-content: space-between;
  }
  .crtpanel input {
    flex: 1;
  }
  .sourcehead {
    align-items: flex-start;
  }
  .sourcehead button {
    padding: 8px;
    font-size: 8px;
  }
}
@media (max-width: 360px) {
  .topline span:first-child {
    max-width: 120px;
    line-height: 1.4;
  }
  .topline i {
    min-width: 6px;
  }
  .playergrid {
    grid-template-columns: 76px minmax(0, 1fr);
  }
  .transport button {
    padding: 8px 6px;
  }
  .visualtiles {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .nav button {
    font-size: 6px;
  }
}
.visualpreview {
  width: 100%;
  height: 100%;
  display: block;
  color: var(--ph);
  overflow: visible;
  filter: drop-shadow(0 0 4px currentColor);
}
.visualpreview .drawwave {
  stroke-dasharray: 120;
  stroke-dashoffset: 120;
  animation: tracewave 2.4s linear infinite;
}
.visualpreview .spectrumbar {
  transform-box: fill-box;
  transform-origin: bottom;
  animation: barbeat 0.8s ease-in-out infinite alternate;
}
.visualpreview .radarsweep,
.visualpreview .radartrail {
  transform-origin: 50px 26px;
  animation: radarscan 3s linear infinite;
}
.visualpreview .pulsepath {
  stroke-dasharray: 140;
  stroke-dashoffset: 140;
  animation: tracewave 2s linear infinite;
}
.visualpreview .star {
  animation: twinkle 1.8s ease-in-out infinite alternate;
}
.visualpreview .reactorcore {
  transform-origin: 50px 27px;
  animation: spin 7s linear infinite;
}
.visualpreview .speedlines {
  animation: linespeed 0.7s linear infinite;
}
.visualpreview .reel {
  transform-origin: center;
  animation: spin 3s linear infinite;
}
.visualpreview .bubble {
  animation: floatbubble 2.8s ease-in-out infinite;
}
.visualpreview .sonowave {
  animation: sonar 1.8s ease-in-out infinite alternate;
}
.visualpreview .neuron {
  animation: neuronpulse 1.6s ease-in-out infinite alternate;
}
.visualpreview .streak {
  animation: warp 0.9s ease-in infinite;
}
.visualpreview .orbit {
  transform-origin: 50px 26px;
  animation: spin 5s linear infinite;
}
.visualpreview .orbit2 {
  animation-direction: reverse;
  animation-duration: 7s;
}
.visualpreview .gaugehand {
  transform-origin: 50px 42px;
  animation: gauge 3s ease-in-out infinite alternate;
}
.visualpreview .blade {
  animation: blade 2.5s linear infinite;
}
.visualpreview .datacol {
  animation: datastream 1.3s linear infinite;
}
.visualpreview .fluidline {
  animation: fluid 2.5s ease-in-out infinite alternate;
}
.visualpreview .branch {
  stroke-dasharray: 80;
  stroke-dashoffset: 80;
  animation: tracewave 3s ease-in-out infinite;
}
.visualpreview .drumpad {
  animation: padbeat 1s ease-in-out infinite alternate;
}
.visualpreview .fader {
  animation: mixfader 1.7s ease-in-out infinite alternate;
}
.visualpreview .toporing {
  animation: topomap 3s ease-in-out infinite alternate;
}
@keyframes tracewave {
  to {
    stroke-dashoffset: 0;
  }
}
@keyframes barbeat {
  to {
    transform: scaleY(0.25);
  }
}
@keyframes radarscan {
  to {
    transform: rotate(360deg);
  }
}
@keyframes twinkle {
  to {
    opacity: 0.15;
    transform: scale(0.6);
  }
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes linespeed {
  to {
    transform: translate(-7px);
  }
}
@keyframes floatbubble {
  50% {
    transform: translateY(-5px);
    opacity: 0.45;
  }
}
@keyframes sonar {
  to {
    transform: translate(3px);
    opacity: 0.35;
  }
}
@keyframes neuronpulse {
  to {
    opacity: 0.25;
    filter: drop-shadow(0 0 4px currentColor);
  }
}
@keyframes warp {
  to {
    opacity: 0.1;
    transform: translate(8px);
  }
}
@keyframes gauge {
  to {
    transform: rotate(18deg);
  }
}
@keyframes blade {
  to {
    transform: rotate(360deg);
  }
}
@keyframes datastream {
  to {
    transform: translateY(5px);
    opacity: 0.3;
  }
}
@keyframes fluid {
  to {
    transform: translate(3px);
    opacity: 0.35;
  }
}
@keyframes padbeat {
  to {
    opacity: 0.2;
  }
}
@keyframes mixfader {
  to {
    transform: translateY(15px);
  }
}
@keyframes topomap {
  to {
    transform: scale(1.12);
    opacity: 0.35;
  }
}

/* WAVELENGTH connected YouTube music deck */
.yt-page {
  min-height: 100vh;
  background: #05090c;
  color: #d9faff;
  padding: clamp(20px, 4vw, 56px);
  font-family: inherit;
}
.yt-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  margin: 0 auto 28px;
  max-width: 1440px;
}
.yt-kicker,
.yt-section-head,
.yt-actions,
.yt-back {
  font-family: ui-monospace, SFMono-Regular, monospace;
  letter-spacing: 0.12em;
  font-size: 10px;
  color: #6ceaff;
}
.yt-page h1 {
  font-size: clamp(34px, 6vw, 72px);
  line-height: 0.95;
  letter-spacing: -0.06em;
  margin: 12px 0;
  color: #eaffff;
}
.yt-page h1 span {
  color: #42dfff;
  text-shadow: 0 0 22px #24cfff77;
}
.yt-sub {
  color: #82a9b3;
  font-size: 13px;
}
.yt-back {
  border: 1px solid #1b5361;
  padding: 12px 15px;
  text-decoration: none;
  white-space: nowrap;
}
.yt-search {
  max-width: 1440px;
  margin: 0 auto 26px;
  display: flex;
  border: 1px solid #1b5361;
  background: #071116;
}
.yt-search input {
  flex: 1;
  min-width: 0;
  background: transparent;
  color: #eaffff;
  border: 0;
  padding: 17px;
  font:
    12px ui-monospace,
    monospace;
  outline: none;
}
.yt-search button {
  background: #0a2730;
  border: 0;
  border-left: 1px solid #1b5361;
  color: #70eaff;
  padding: 0 24px;
  font:
    11px ui-monospace,
    monospace;
  letter-spacing: 0.1em;
  cursor: pointer;
}
.yt-search button:disabled {
  opacity: 0.5;
}
.yt-layout {
  max-width: 1440px;
  margin: auto;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
  gap: 22px;
}
.yt-results,
.yt-now {
  border: 1px solid #174451;
  background: #071015;
  min-width: 0;
}
.yt-section-head {
  display: flex;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid #174451;
}
.yt-result {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 14px;
  text-align: left;
  background: transparent;
  border: 0;
  border-bottom: 1px solid #102e38;
  padding: 10px 14px;
  color: inherit;
  cursor: pointer;
}
.yt-result:hover,
.yt-result.active {
  background: #0b2028;
}
.yt-result img {
  width: 104px;
  aspect-ratio: 16/9;
  object-fit: cover;
  background: #10232b;
}
.yt-result-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 5px;
}
.yt-result-copy strong,
.yt-track strong {
  font-size: 12px;
  line-height: 1.4;
  color: #dffaff;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.yt-result-copy small,
.yt-track small {
  font-size: 10px;
  color: #6f9ca8;
}
.yt-play {
  color: #50dcf5;
}
.yt-empty,
.yt-idle {
  padding: 42px 20px;
  text-align: center;
  color: #5d8792;
  font:
    11px ui-monospace,
    monospace;
  letter-spacing: 0.1em;
}
.yt-player {
  width: 100%;
  aspect-ratio: 16/9;
  background: #000;
}
.yt-player iframe {
  width: 100%;
  height: 100%;
  border: 0;
}
.yt-track {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px;
}
.yt-track img {
  width: 76px;
  aspect-ratio: 16/9;
  object-fit: cover;
}
.yt-track div {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
}
.yt-actions {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-top: 1px solid #174451;
}
.yt-actions a {
  color: #6ceaff;
  text-decoration: none;
}
.yt-note {
  padding: 0 14px 14px;
  color: #63838b;
  font-size: 10px;
  line-height: 1.5;
}
.yt-idle span {
  font-size: 44px;
  color: #36d7f5;
  text-shadow: 0 0 28px #36d7f588;
}
.yt-error {
  max-width: 1440px;
  margin: 0 auto 18px;
  color: #ff9b9b;
  font-size: 12px;
}
@media (max-width: 800px) {
  .yt-top {
    flex-direction: column;
  }
  .yt-layout {
    grid-template-columns: 1fr;
  }
  .yt-back {
    align-self: flex-start;
  }
  .yt-page {
    padding: 18px;
  }
  .yt-result img {
    width: 88px;
  }
}

/* SONIC FORGE / LOTOS CRT signal workstation */
.ae-page {
  min-height: 100vh;
  padding: clamp(18px, 4vw, 54px);
  color: #9bff83;
  background:
    radial-gradient(
      ellipse at 50% 18%,
      rgba(15, 55, 28, 0.24),
      transparent 42%
    ),
    #020a04;
  font-family: var(--font-mono, monospace);
  letter-spacing: 0.055em;
}
.ae-header,
.ae-deck-head,
.ae-section-head,
.ae-rack-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 22px;
}
.ae-header {
  padding: 14px 0 28px;
  border-bottom: 1px solid rgba(116, 180, 255, 0.55);
  margin-bottom: 28px;
}
.ae-kicker {
  font-size: 11px;
  letter-spacing: 0.2em;
  color: #6e91c4;
  margin: 0 0 12px;
  text-transform: uppercase;
}
.ae-header h1 {
  font-size: clamp(30px, 6vw, 58px);
  line-height: 1;
  margin: 0;
  text-shadow: 0 0 18px rgba(133, 255, 128, 0.35);
  letter-spacing: 0.08em;
}
.ae-header h1 span {
  color: #79bfff;
  text-shadow: 0 0 18px rgba(91, 174, 255, 0.55);
}
.ae-sub {
  font-size: 12px;
  color: #83a5d2;
  letter-spacing: 0.18em;
  margin: 16px 0 0;
}
.ae-back,
.ae-load,
.ae-transport button,
.ae-rack-foot button {
  border: 1px solid #3c6c9d;
  color: #8fc8ff;
  background: rgba(2, 14, 10, 0.8);
  padding: 13px 17px;
  text-decoration: none;
  font: inherit;
  font-size: 11px;
  letter-spacing: 0.14em;
  cursor: pointer;
  transition:
    background 0.2s,
    box-shadow 0.2s,
    transform 0.2s;
}
.ae-back:hover,
.ae-load:hover,
.ae-transport button:hover,
.ae-rack-foot button:hover {
  background: #78bfff;
  color: #03101b;
  box-shadow: 0 0 22px #4caaff;
  transform: translateY(-2px);
}
.ae-deck,
.ae-workspace,
.ae-rack {
  border: 1px solid rgba(109, 159, 221, 0.55);
  background: rgba(3, 14, 7, 0.74);
  padding: clamp(16px, 3vw, 28px);
  margin: 22px 0;
  box-shadow: inset 0 0 24px rgba(34, 99, 60, 0.08);
}
.ae-deck h2,
.ae-rack h2,
.ae-section-head h2 {
  font-size: clamp(18px, 3vw, 26px);
  margin: 0 0 9px;
  color: #9bff83;
  letter-spacing: 0.08em;
}
.ae-deck-head p:not(.ae-kicker),
.ae-section-head p:not(.ae-kicker),
.ae-rack-title p:not(.ae-kicker) {
  font-size: 12px;
  color: #7591a9;
  line-height: 1.7;
  margin: 0;
}
.ae-load {
  position: relative;
  overflow: hidden;
  white-space: nowrap;
}
.ae-load input {
  position: absolute;
  inset: 0;
  opacity: 0;
  width: 100%;
  cursor: pointer;
}
.ae-audio {
  display: block;
  width: 100%;
  margin: 24px 0 12px;
  accent-color: #83c7ff;
  filter: sepia(0.25) hue-rotate(165deg);
}
.ae-transport {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
.ae-transport span {
  font-size: 10px;
  color: #7fa1c8;
  letter-spacing: 0.13em;
}
.ae-transport .ae-note {
  margin-left: auto;
  color: #587b68;
}
.ae-section-head {
  margin-bottom: 20px;
  align-items: flex-end;
}
.ae-count,
.ae-live {
  font-size: 10px;
  letter-spacing: 0.15em;
  color: #82bfff;
  border: 1px solid #294f75;
  padding: 8px 10px;
  white-space: nowrap;
}
.ae-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}
.ae-pad {
  min-height: 132px;
  text-align: left;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 15px;
  border: 1px solid rgba(93, 143, 198, 0.52);
  background: linear-gradient(
    145deg,
    rgba(6, 23, 14, 0.98),
    rgba(2, 9, 5, 0.98)
  );
  color: #85bfff;
  cursor: pointer;
  overflow: hidden;
  transition: all 0.22s ease;
}
.ae-pad:before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    110deg,
    transparent 20%,
    rgba(115, 190, 255, 0.08) 48%,
    transparent 75%
  );
  transform: translateX(-110%);
  transition: transform 0.55s;
}
.ae-pad:hover:before {
  transform: translateX(110%);
}
.ae-pad:hover {
  border-color: #83c7ff;
  box-shadow: 0 0 18px rgba(70, 165, 255, 0.2);
  transform: translateY(-2px);
}
.ae-pad.active {
  background: #79bdff;
  color: #03111c;
  border-color: #a7dcff;
  box-shadow:
    0 0 24px rgba(71, 169, 255, 0.7),
    inset 0 0 22px rgba(255, 255, 255, 0.2);
}
.ae-pad-no {
  font-size: 9px;
  letter-spacing: 0.17em;
  opacity: 0.75;
}
.ae-pad-name {
  font-size: clamp(12px, 1.3vw, 16px);
  font-weight: 800;
  letter-spacing: 0.09em;
}
.ae-pad-desc {
  font-size: 10px;
  line-height: 1.5;
  opacity: 0.72;
  letter-spacing: 0.03em;
  max-width: 28ch;
}
.ae-pad-led {
  position: absolute;
  right: 13px;
  top: 13px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #69baff;
  box-shadow: 0 0 10px currentColor;
  animation: ae-blink 2s infinite;
}
.ae-pad.active .ae-pad-led {
  background: #03111c;
}
.ae-rack {
  border-color: rgba(117, 184, 255, 0.75);
  box-shadow:
    0 0 26px rgba(58, 135, 219, 0.08),
    inset 0 0 28px rgba(30, 91, 55, 0.08);
}
.ae-controls {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin: 26px 0;
}
.ae-control {
  border: 1px solid rgba(83, 126, 177, 0.4);
  padding: 16px;
  background: rgba(2, 10, 6, 0.7);
  min-width: 0;
}
.ae-control > span {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 12px;
  color: #9bc9ff;
}
.ae-control output {
  color: #9bff83;
  font-variant-numeric: tabular-nums;
}
.ae-control input {
  width: 100%;
  margin: 19px 0 9px;
  accent-color: #80c4ff;
  cursor: pointer;
}
.ae-control small {
  display: block;
  color: #597966;
  font-size: 9px;
  letter-spacing: 0.08em;
}
.ae-rack-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  border-top: 1px solid rgba(94, 141, 106, 0.35);
  padding-top: 18px;
}
.ae-rack-foot span,
.ae-footnote {
  font-size: 9px;
  color: #66856e;
  letter-spacing: 0.12em;
  line-height: 1.8;
}
.ae-footnote {
  max-width: 900px;
  margin: 28px auto;
  text-align: center;
}
@keyframes ae-blink {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}
@media (max-width: 850px) {
  .ae-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .ae-controls {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 560px) {
  .ae-page {
    padding: 16px 12px 34px;
  }
  .ae-header,
  .ae-deck-head,
  .ae-rack-title {
    flex-direction: column;
  }
  .ae-back {
    align-self: flex-start;
  }
  .ae-grid {
    gap: 7px;
  }
  .ae-pad {
    min-height: 138px;
    padding: 11px;
  }
  .ae-controls {
    grid-template-columns: 1fr;
    gap: 9px;
  }
  .ae-rack-foot {
    align-items: flex-start;
    flex-direction: column;
  }
  .ae-transport .ae-note {
    margin-left: 0;
    width: 100%;
  }
  .ae-count,
  .ae-live {
    align-self: flex-start;
  }
}
.yt-track img {
  filter: grayscale(0.3) sepia(0.28) hue-rotate(165deg) saturate(1.65)
    contrast(1.12);
  box-shadow: 0 0 18px rgba(88, 174, 255, 0.25);
  border: 1px solid rgba(116, 190, 255, 0.65);
}
.yt-track {
  position: relative;
}
.yt-track:after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    135deg,
    rgba(73, 160, 255, 0.08),
    transparent 45%,
    rgba(111, 255, 139, 0.06)
  );
  mix-blend-mode: screen;
}

/* Qobuz module surface, LOTOS CRT visual language */
.qb-page {
  min-height: 100vh;
  padding: clamp(22px, 4vw, 54px);
  background: #03070b;
  color: #c9faff;
  font-family: var(--font-mono, monospace);
  background-image:
    linear-gradient(rgba(0, 210, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 210, 255, 0.035) 1px, transparent 1px);
  background-size: 24px 24px;
  position: relative;
  overflow: hidden;
}
.qb-page:after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.16) 0px,
    rgba(0, 0, 0, 0.16) 1px,
    transparent 2px,
    transparent 4px
  );
  opacity: 0.35;
}
.qb-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24px;
  margin: 0 auto 30px;
  max-width: 1400px;
}
.qb-kicker,
.qb-toolbar,
.qb-section-title,
.qb-footer {
  font-size: 10px;
  letter-spacing: 0.16em;
  color: #5acfe9;
}
.qb-head h1 {
  font-size: clamp(32px, 6vw, 64px);
  letter-spacing: 0.08em;
  margin: 8px 0;
  color: #e2fdff;
  text-shadow: 0 0 18px #00bfe9;
}
.qb-head h1 span {
  color: #35cce9;
}
.qb-sub {
  font-size: 12px;
  color: #70aab7;
}
.qb-back {
  font-size: 11px;
  color: #75eaff;
  text-decoration: none;
  border: 1px solid #12617a;
  padding: 12px 15px;
  white-space: nowrap;
}
.qb-search {
  max-width: 1400px;
  margin: 0 auto 14px;
  display: flex;
  border: 1px solid #14627a;
  background: #06121a;
  box-shadow: 0 0 18px #00b9e51a;
}
.qb-search input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: 0;
  outline: 0;
  color: #d8fbff;
  padding: 17px;
  font: 12px monospace;
  letter-spacing: 0.1em;
}
.qb-search button {
  background: #06364a;
  color: #aaf5ff;
  border: 0;
  border-left: 1px solid #14627a;
  padding: 0 25px;
  font: 11px monospace;
  letter-spacing: 0.12em;
  cursor: pointer;
}
.qb-search button:disabled {
  opacity: 0.55;
}
.qb-toolbar {
  max-width: 1400px;
  margin: 0 auto 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}
.qb-toolbar label {
  display: flex;
  align-items: center;
  gap: 10px;
}
.qb-toolbar select {
  background: #06121a;
  border: 1px solid #14627a;
  color: #aaf5ff;
  padding: 8px;
  font: 10px monospace;
}
.qb-error {
  max-width: 1400px;
  margin: 0 auto 18px;
  color: #ff9b9b;
  font-size: 12px;
}
.qb-grid {
  max-width: 1400px;
  margin: auto;
  display: grid;
  grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.8fr);
  gap: 18px;
}
.qb-results,
.qb-now {
  border: 1px solid #10536a;
  background: rgba(3, 14, 21, 0.88);
  box-shadow: 0 0 22px #00bfe90d;
  padding: 18px;
  min-width: 0;
}
.qb-section-title {
  display: flex;
  justify-content: space-between;
  padding-bottom: 14px;
  border-bottom: 1px solid #12465a;
  margin-bottom: 10px;
}
.qb-track {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 10px 8px;
  text-align: left;
  background: transparent;
  border: 0;
  border-bottom: 1px solid #0b2935;
  color: #c8f8ff;
  cursor: pointer;
}
.qb-track:hover,
.qb-track.active {
  background: #082532;
}
.qb-track img,
.qb-art-empty {
  width: 52px;
  height: 52px;
  object-fit: cover;
  flex: none;
}
.qb-art-empty {
  display: grid;
  place-items: center;
  background: #082e3c;
  color: #42d7f5;
  font-size: 20px;
}
.qb-track-copy {
  display: grid;
  gap: 4px;
  min-width: 0;
  flex: 1;
}
.qb-track-copy strong {
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.qb-track-copy small,
.qb-now > p,
.qb-now > small {
  font-size: 10px;
  color: #70aab7;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.qb-track-copy .qb-quality {
  color: #43cfe9;
}
.qb-track-time {
  font-size: 10px;
  color: #70aab7;
}
.qb-play-mark {
  color: #4ce0ff;
  width: 18px;
  text-align: center;
}
.qb-empty {
  padding: 70px 10px;
  text-align: center;
  color: #326f7e;
  font-size: 11px;
  letter-spacing: 0.14em;
}
.qb-live {
  color: #4ee7bb;
}
.qb-now {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.qb-now .qb-section-title {
  width: 100%;
  text-align: left;
}
.qb-cover {
  width: min(100%, 260px);
  aspect-ratio: 1;
  object-fit: cover;
  margin: 16px auto;
  border: 1px solid #16728b;
  box-shadow: 0 0 28px #00cfff28;
}
.qb-cover-empty {
  display: grid;
  place-items: center;
  background: radial-gradient(circle, #0c3948, #04121b 68%);
  color: #48d7f4;
  font-size: 12px;
  letter-spacing: 0.15em;
}
.qb-now h2 {
  font-size: 16px;
  margin: 8px 0 5px;
  max-width: 100%;
  overflow-wrap: anywhere;
}
.qb-now > p {
  margin: 0 0 5px;
}
.qb-progress {
  width: 100%;
  margin-top: 22px;
}
.qb-progress input {
  width: 100%;
  accent-color: #31d7f5;
}
.qb-progress div {
  display: flex;
  justify-content: space-between;
  color: #5f9eac;
  font-size: 10px;
}
.qb-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  margin: 18px;
}
.qb-controls button {
  background: transparent;
  border: 1px solid #17657b;
  color: #7cecff;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  cursor: pointer;
}
.qb-controls .qb-main-play {
  width: 54px;
  height: 54px;
  background: #073b4d;
  box-shadow: 0 0 18px #00cfff35;
  font-size: 18px;
}
.qb-controls button:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}
.qb-footer {
  margin-top: auto;
  padding-top: 14px;
}
.qb-now .qb-cover-empty {
  width: min(100%, 260px);
  aspect-ratio: 1;
  margin: 16px auto;
}
.qb-page audio {
  display: none;
}
@media (max-width: 800px) {
  .qb-grid {
    grid-template-columns: 1fr;
  }
  .qb-head {
    flex-direction: column;
  }
  .qb-back {
    align-self: flex-start;
  }
  .qb-now {
    min-height: 500px;
  }
  .qb-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }
}

.fx-lab .notice {
  letter-spacing: 0.12em;
  font-size: 10px;
  color: var(--muted, #8b9aa5);
  margin: 12px 0 18px;
}
.fx-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}
.fx-tile {
  position: relative;
  min-height: 92px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  padding: 13px;
  background: #080e13;
  border: 1px solid #263944;
  color: #9aabb5;
  text-align: left;
  cursor: pointer;
  transition: 0.18s ease;
}
.fx-tile:hover,
.fx-tile.is-selected {
  border-color: #39d8f4;
  box-shadow: inset 0 0 18px #12b9d51a;
}
.fx-tile.is-on {
  background: linear-gradient(145deg, #0c2932, #081219);
  border-color: #27c9e7;
  color: #baf5ff;
}
.fx-tile b {
  font-size: 11px;
  letter-spacing: 0.1em;
}
.fx-tile small {
  font-size: 9px;
  letter-spacing: 0.16em;
  color: #728792;
}
.fx-led {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #34434c;
  box-shadow: 0 0 0 3px #26343c55;
}
.fx-tile.is-on .fx-led {
  background: #40e4ff;
  box-shadow: 0 0 10px #40e4ff;
}
.fx-editor {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid #263944;
  background: #080e13;
}
.fx-editor h3 {
  font-size: 13px;
  letter-spacing: 0.12em;
}
.fx-controls {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin: 18px 0;
}
.fx-control {
  display: flex;
  flex-direction: column;
  gap: 10px;
  color: #9aabb5;
  font-size: 10px;
  letter-spacing: 0.12em;
}
.fx-control span {
  display: flex;
  justify-content: space-between;
}
.fx-control b {
  color: #54dff7;
}
.fx-control input {
  width: 100%;
  accent-color: #39d8f4;
}
.fx-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.fx-actions span {
  margin-left: auto;
  color: #6f8792;
  font-size: 10px;
  letter-spacing: 0.12em;
}
@media (max-width: 700px) {
  .fx-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .fx-controls {
    grid-template-columns: 1fr;
  }
  .fx-tile {
    min-height: 76px;
  }
}

/* Mobile home layout correction */
.notice {
  border-left: 0 !important;
  padding-left: 0 !important;
  margin: 12px 0 16px !important;
  max-width: 100%;
  line-height: 1.65;
  overflow-wrap: anywhere;
}
.homegrid {
  grid-template-columns: minmax(0, 1fr);
  gap: 16px;
  align-items: start;
  min-height: 0;
}
.homegrid > div:first-child {
  min-width: 0;
  width: 100%;
  text-align: left;
}
.homegrid h2 {
  font-size: clamp(25px, 7.2vw, 42px);
  line-height: 1.14;
  letter-spacing: 0.015em;
  max-width: 100%;
  text-align: left;
  overflow-wrap: normal;
  word-break: normal;
  margin: 12px 0;
}
.homegrid > div:first-child > small {
  display: block;
  text-align: left;
}
.homeart {
  height: 190px;
  width: 100%;
}
.homeactions {
  grid-column: 1;
  min-width: 0;
}
.homeactions button {
  font-size: 10px;
  padding: 9px 8px;
}
@media (min-width: 760px) {
  .homegrid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
    min-height: 400px;
  }
  .homeart {
    height: 270px;
  }
  .homeactions {
    grid-column: 1/-1;
  }
}

.instrument-workbench {
  border: 1px solid #345b2b;
  background: rgba(3, 18, 6, 0.88);
  padding: 18px;
  margin-top: 18px;
  color: #b4ff91;
  box-shadow: 0 0 24px #4dff3310;
}
.iw-head {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}
.iw-head small,
.iw-sequencer > b {
  font: 700 10px monospace;
  letter-spacing: 2px;
  color: #8bdc72;
}
.iw-head h2 {
  font: 800 20px monospace;
  letter-spacing: 2px;
  margin: 7px 0;
}
.iw-head p {
  font: 11px monospace;
  color: #71936b;
  margin: 0 0 12px;
}
.iw-status {
  font: 10px monospace;
  color: #7c9673;
  white-space: nowrap;
}
.iw-status.on {
  color: #aaff85;
}
.iw-display {
  display: block;
  width: 100%;
  height: 150px;
  border: 1px solid #345b2b;
  background: radial-gradient(ellipse, #102b12, #020b04);
  margin: 12px 0;
}
.iw-controls {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}
.iw-controls label span {
  display: flex;
  justify-content: space-between;
  font: 10px monospace;
  letter-spacing: 1px;
}
.iw-controls b {
  color: #b6ff8c;
}
.iw-controls input {
  width: 100%;
  accent-color: #9bff79;
  margin-top: 10px;
}
.iw-extra,
.iw-sequencer {
  margin-top: 16px;
}
.iw-extra label {
  font: 10px monospace;
  letter-spacing: 1px;
}
.iw-extra select {
  margin-left: 10px;
  background: #061308;
  color: #b4ff91;
  border: 1px solid #456a37;
  padding: 8px;
}
.iw-keys {
  display: flex;
  gap: 5px;
  margin-top: 10px;
}
.iw-keys button,
.iw-mix button {
  flex: 1;
  min-width: 0;
  background: #0b1d0d;
  color: #b4ff91;
  border: 1px solid #47733a;
  padding: 12px 3px;
  font: 700 12px monospace;
}
.iw-steps {
  display: grid;
  grid-template-columns: repeat(16, minmax(0, 1fr));
  gap: 5px;
  margin-top: 10px;
}
.iw-steps button {
  height: 34px;
  min-width: 0;
  background: #102314;
  border: 1px solid #426238;
}
.iw-steps button.hit {
  background: #9bff79;
  box-shadow: 0 0 10px #9bff79;
}
.iw-steps button.current {
  outline: 2px solid #e3ffd8;
  outline-offset: 2px;
}
.iw-actions {
  display: flex;
  gap: 8px;
  margin-top: 16px;
  flex-wrap: wrap;
}
.iw-actions button {
  background: #071609;
  border: 1px solid #456a37;
  color: #a9e88e;
  padding: 11px 15px;
  font: 700 10px monospace;
  letter-spacing: 1px;
}
.iw-actions .iw-play {
  background: #9bff79;
  color: #061006;
  border-color: #9bff79;
}
.iw-mix {
  display: flex;
  gap: 8px;
  margin-top: 12px;
}
@media (max-width: 600px) {
  .instrument-workbench {
    padding: 12px;
  }
  .iw-head h2 {
    font-size: 16px;
  }
  .iw-controls {
    grid-template-columns: 1fr;
    gap: 10px;
  }
  .iw-display {
    height: 125px;
  }
  .iw-steps {
    gap: 3px;
  }
  .iw-steps button {
    height: 28px;
  }
  .iw-keys button {
    padding: 12px 1px;
    font-size: 10px;
  }
}

.eq-console {
  margin: 18px 0 22px;
  padding: 16px;
  border: 1px solid rgba(80, 210, 255, 0.24);
  background: rgba(0, 24, 34, 0.42);
  box-shadow: inset 0 0 22px rgba(0, 170, 220, 0.05);
}
.eq-sliders {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 14px;
}
.eq-band {
  display: grid;
  gap: 10px;
  color: #8deaff;
  font: 11px/1.4 monospace;
  letter-spacing: 0.12em;
}
.eq-band b {
  font-size: 18px;
  color: #e8fbff;
  font-weight: 500;
}
.eq-band input {
  width: 100%;
  accent-color: #00cfff;
}
@media (max-width: 600px) {
  .eq-console {
    padding: 12px;
  }
  .eq-sliders {
    gap: 10px;
  }
  .eq-band {
    font-size: 9px;
  }
  .eq-band b {
    font-size: 15px;
  }
}

/* Rotary controls for the Frequency Lab effect matrix */
.fx-knob-tile {
  min-height: 142px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px !important;
}
.fx-tile-top {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}
.fx-led-toggle {
  appearance: none;
  border: 0;
  border-radius: 50%;
  width: 13px;
  height: 13px;
  min-width: 13px;
  padding: 0;
  background: #26313a;
  box-shadow:
    inset 0 0 0 3px #111a20,
    0 0 0 1px #34424b;
  cursor: pointer;
}
.fx-led-toggle.led-on {
  background: #42eaff;
  box-shadow:
    0 0 5px #42eaff,
    0 0 14px #16cce8,
    inset 0 0 0 3px #0c3440;
}
.fx-name {
  background: none;
  border: 0;
  color: inherit;
  padding: 0;
  text-align: left;
  font: inherit;
  font-weight: 800;
  letter-spacing: 0.12em;
  cursor: pointer;
  flex: 1;
}
.fx-status {
  margin-left: auto;
  font-size: 10px;
  letter-spacing: 0.16em;
  color: #83939d;
}
.fx-knob-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
}
.fx-knob-wrap {
  width: 66px;
  height: 66px;
  position: relative;
  display: grid;
  place-items: center;
  flex: 0 0 66px;
}
.fx-knob-face {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  position: relative;
  background: radial-gradient(
    circle at 35% 28%,
    #34434c 0,
    #17232a 42%,
    #080e12 74%
  );
  border: 2px solid #52636c;
  box-shadow:
    0 4px 10px #000b,
    inset 0 2px 5px #82939a55,
    inset 0 -5px 8px #000;
}
.fx-knob-face:before {
  content: "";
  position: absolute;
  inset: 5px;
  border-radius: 50%;
  border: 1px solid #52636b66;
}
.fx-knob-face i {
  position: absolute;
  width: 3px;
  height: 13px;
  border-radius: 3px;
  background: #58eaff;
  left: 50%;
  top: 5px;
  transform: translateX(-50%) rotate(var(--knob-angle));
  transform-origin: 50% 23px;
  box-shadow: 0 0 7px #39eaff;
}
.fx-knob-input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: grab;
  touch-action: pan-y;
}
.fx-knob-input:active {
  cursor: grabbing;
}
.fx-knob-value {
  min-width: 42px;
  color: #83eaff;
  font: 700 12px/1 monospace;
  letter-spacing: 0.08em;
}
.fx-tile.is-on {
  border-color: #38dff3 !important;
  box-shadow:
    inset 0 0 18px #12d9ef13,
    0 0 8px #12d9ef20;
}
.fx-tile.is-selected {
  outline: 1px solid #53e9ff;
  outline-offset: -1px;
}
@media (max-width: 600px) {
  .fx-knob-tile {
    min-height: 132px;
    padding: 12px !important;
  }
  .fx-knob-wrap {
    width: 58px;
    height: 58px;
    flex-basis: 58px;
  }
  .fx-knob-face {
    width: 50px;
    height: 50px;
  }
  .fx-knob-face i {
    transform-origin: 50% 20px;
  }
  .fx-knob-row {
    gap: 8px;
  }
}

/* Horizontal drag scrubber replaces rotary dials */
.fx-knob-tile {
  min-height: 112px;
}
.fx-scrub-row {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
}
.fx-scrub-control {
  display: flex;
  align-items: center;
  gap: 7px;
  flex: 1;
  min-width: 0;
}
.fx-scrub-min,
.fx-scrub-max {
  color: #71818a;
  font: 10px monospace;
}
.fx-scrub-input {
  appearance: none;
  -webkit-appearance: none;
  width: 100%;
  min-width: 40px;
  height: 26px;
  margin: 0;
  background: transparent;
  cursor: ew-resize;
  touch-action: pan-y;
}
.fx-scrub-input::-webkit-slider-runnable-track {
  height: 5px;
  border-radius: 2px;
  background: linear-gradient(
    90deg,
    #31dff5 0%,
    #31dff5 var(--scrub-fill, 50%),
    #26343d var(--scrub-fill, 50%),
    #26343d 100%
  );
  border: 1px solid #40535d;
}
.fx-scrub-input::-moz-range-track {
  height: 5px;
  border-radius: 2px;
  background: #26343d;
  border: 1px solid #40535d;
}
.fx-scrub-input::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 13px;
  height: 17px;
  margin-top: -7px;
  border-radius: 2px;
  background: #d8faff;
  border: 1px solid #47dff4;
  box-shadow: 0 0 8px #2ddcf5;
}
.fx-scrub-input::-moz-range-thumb {
  width: 11px;
  height: 15px;
  border-radius: 2px;
  background: #d8faff;
  border: 1px solid #47dff4;
  box-shadow: 0 0 8px #2ddcf5;
}
.fx-scrub-input:focus-visible {
  outline: 1px solid #45e7ff;
  outline-offset: 3px;
}
@media (max-width: 600px) {
  .fx-knob-tile {
    min-height: 104px;
  }
  .fx-scrub-row {
    gap: 7px;
  }
}
/* Keep effect cards neutral, no persistent cyan selection outline */
.fx-tile:hover,
.fx-tile.is-selected {
  border-color: #263944 !important;
  box-shadow: none !important;
}
.fx-name {
  outline: none !important;
  user-select: none;
  -webkit-user-select: none;
}
.fx-name:focus,
.fx-name:focus-visible {
  outline: none !important;
  box-shadow: none !important;
}

/* Expanded phosphor palette for the CRT tuning panel */
.crt[data-tone="cyan"] {
  --ph: #62f5ef;
  --line: #42dcd588;
  --dim: #71fff099;
  --glow: 0 0 8px #31fff0, 0 0 26px #00bfb055;
}
.crt[data-tone="violet"] {
  --ph: #bd9aff;
  --line: #a77cff88;
  --dim: #c7aaff99;
  --glow: 0 0 8px #a46cff, 0 0 28px #783dff66;
}
.crt[data-tone="pink"] {
  --ph: #ff8edb;
  --line: #ff72cb88;
  --dim: #ffa4e399;
  --glow: 0 0 8px #ff62c9, 0 0 28px #ff2aa866;
}
.crt[data-tone="amber"] {
  --ph: #ffc36f;
  --line: #ffb24f88;
  --dim: #ffd09299;
  --glow: 0 0 8px #ffb34f, 0 0 28px #ff7b2566;
}
.tone-picker {
  display: grid;
  gap: 9px;
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px solid var(--line);
}
.tone-picker > b {
  font-size: 10px;
  letter-spacing: 0.16em;
  color: var(--dim);
}
.tone-options {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}
.tone-options button {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 9px;
  padding: 7px 9px;
}
.tone-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--tone-dot);
  box-shadow: 0 0 8px var(--tone-dot);
}
.tone-dot[data-tone-dot="green"] {
  --tone-dot: #9bff79;
}
.tone-dot[data-tone-dot="blue"] {
  --tone-dot: #78c0ff;
}
.tone-dot[data-tone-dot="cyan"] {
  --tone-dot: #62f5ef;
}
.tone-dot[data-tone-dot="violet"] {
  --tone-dot: #bd9aff;
}
.tone-dot[data-tone-dot="pink"] {
  --tone-dot: #ff8edb;
}
.tone-dot[data-tone-dot="amber"] {
  --tone-dot: #ffc36f;
}
/* Curvature is applied to the whole CRT glass, not just the scanline overlay. */
.crt[data-crt="on"] {
  isolation: isolate;
}
.crt[data-crt="on"]:before {
  inset: 0;
  transform: perspective(720px) scale(calc(1 + var(--crt-curve) * 0.0007));
  border-radius: calc(var(--crt-curve) * 3.5%);
  box-shadow:
    inset 0 0 calc(var(--crt-curve) * 36px) calc(var(--crt-curve) * 5px) #000,
    inset 0 0 calc(var(--crt-curve) * 18px) #000b;
  background:
    repeating-linear-gradient(to bottom, transparent 0 2px, #0007 3px 4px),
    radial-gradient(
      ellipse at center,
      transparent 38%,
      rgba(0, 0, 0, calc(0.18 + var(--crt-curve) * 0.68)) 100%
    );
}
.crtpanel input[type="range"] {
  width: 100%;
  accent-color: var(--ph);
  cursor: ew-resize;
}

/* Default CRT glass: pronounced convex tube curvature */
.crt {
  --crt-curve: 0.72;
}
.crt[data-crt="on"]:before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 50;
  border-radius: clamp(18px, 3.2vw, 48px);
  box-shadow:
    inset 0 0 34px 12px #000b,
    inset 0 0 110px 24px #0008;
  opacity: calc(0.28 + var(--crt-curve) * 0.55);
}
.crt[data-crt="on"]:after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 49;
  background: radial-gradient(
    ellipse at 50% 48%,
    transparent 48%,
    #0000 61%,
    #0009 100%
  );
  border-radius: clamp(18px, 3.2vw, 48px);
  opacity: calc(var(--crt-curve) * 0.72);
}

/* Unified WAVELENGTH addon deck */
.addon-player-panel {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 22px;
}
.addon-panel-head {
  align-items: flex-end;
}
.addon-panel-head small,
.addon-field span {
  display: block;
  font-size: 9px;
  letter-spacing: 0.16em;
  color: var(--muted, #8aa5a8);
  margin-bottom: 7px;
}
.addon-controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.addon-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.addon-field select {
  width: 100%;
  min-height: 42px;
  background: #07151b;
  color: inherit;
  border: 1px solid #24434b;
  border-radius: 4px;
  padding: 0 12px;
  font: inherit;
  font-size: 11px;
  letter-spacing: 0.08em;
}
.addon-searchbar {
  margin: 0;
}
.addon-statusline {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 9px;
  letter-spacing: 0.13em;
  color: var(--muted, #8aa5a8);
}
.addon-results {
  max-height: 380px;
  overflow: auto;
}
.addon-empty {
  padding: 28px 14px;
  text-align: center;
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--muted, #8aa5a8);
  border: 1px solid #18343c;
}
.addon-error {
  margin: 0;
  padding: 10px 12px;
  border: 1px solid #79402f;
  background: #25130f;
  color: #ffad8b;
  font-size: 11px;
  line-height: 1.5;
}
.addon-track-meta {
  text-align: right;
  font-size: 9px;
  line-height: 1.7;
  letter-spacing: 0.08em;
  color: #91dce2;
  white-space: nowrap;
}
.addon-footnote {
  margin: 0;
  font-size: 8px;
  line-height: 1.6;
  letter-spacing: 0.12em;
  color: var(--muted, #8aa5a8);
}
.legacy-player {
  display: none !important;
}
@media (max-width: 640px) {
  .addon-controls {
    grid-template-columns: 1fr;
  }
  .addon-panel-head {
    align-items: flex-start;
    gap: 8px;
    flex-direction: column;
  }
}
